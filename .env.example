# Player da câmera da CDL (o .m3u8 é descoberto sozinho)
PLAYER_URL=https://player.jmvstream.com/ipcam/PsG94AJRDonkpYPM9xNQID9IO8HFva
# Opcional: fixe o .m3u8 se já tiver (pula o navegador headless)
STREAM_URL=

# Gravação no histórico (banco + snapshot) a cada N segundos
INTERVAL_SECONDS=300
KEEP_SNAPSHOTS_DAYS=7

# Tempo real (vídeo e números do painel)
LIVE_FPS=5                      # quadros por segundo do vídeo ao vivo
ANALYSIS_INTERVAL_SECONDS=1     # contagem de pessoas/veículos e movimento (a parte pesada)
LIVE_WIDTH=1280                 # largura do vídeo/snapshot mostrado (0 = original); a análise usa a resolução total
LEVEL_SMOOTH_FRAMES=7           # mediana do nível, evita oscilar a cada frame
WEATHER_TTL_SECONDS=300         # Open-Meteo só atualiza a cada ~15 min

# Caratinga (Open-Meteo)
LAT=-19.789
LON=-42.139

# CEMADEN (dados abertos, sem chave): nível do rio e chuva medidos perto da câmera
CEMADEN_ENABLED=true
CEMADEN_INTERVAL_SECONDS=300
CEMADEN_RADIUS_KM=30
# Vazio = a estação hidrológica e os pluviômetros mais próximos de LAT/LON
CEMADEN_HIDRO_ID=
CEMADEN_PLUVIO_IDS=

# Contagem de pessoas/veículos
ENABLE_YOLO=true
YOLO_CONF=0.35

# IA de visão (opcional): confirma o nível com um modelo multimodal
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
VISION_EVERY_N=6

# Alertas no Telegram (opcional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_LEVEL_PCT=70
ALERT_RISE_PCT_PER_HOUR=10
ALERT_COOLDOWN_MIN=60
